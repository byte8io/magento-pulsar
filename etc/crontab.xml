<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Pull the detection-signature bundle from pulsar-server hourly. -->
        <job name="byte8_pulsar_fetch_signatures"
             instance="Byte8\Pulsar\Cron\FetchSignatures"
             method="execute">
            <schedule>17 * * * *</schedule>
        </job>
    </group>
</config>
