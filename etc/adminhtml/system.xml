<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system.xsd">
    <system>
        <section id="byte8_pulsar" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Pulsar Health Monitoring</label>
            <tab>byte8</tab>
            <resource>Byte8_Pulsar::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>General Settings</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enable Health Endpoint</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Enable or disable the /pulsar/health endpoint</comment>
                </field>
                <field id="api_key" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>API Key</label>
                    <comment><![CDATA[Auto-generated during installation. Copy this key into your Pulsar dashboard. To regenerate, clear the field and save. Requests must include header: <code>X-Pulsar-Key: your-api-key</code>]]></comment>
                    <backend_model>Byte8\Pulsar\Model\Config\Backend\ApiKey</backend_model>
                </field>
            </group>
            <group id="checks" translate="label" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Health Check Options</label>
                <field id="cron_enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Cron Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Check cron job health and stuck jobs</comment>
                </field>
                <field id="cron_pending_warning" translate="label comment" type="text" sortOrder="11" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Cron Pending Jobs Warning Threshold</label>
                    <comment>Number of overdue pending jobs before status becomes degraded (default: 200). Increase for busy stores with frequent imports.</comment>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="cron_enabled">1</field>
                    </depends>
                </field>
                <field id="cron_failed_warning" translate="label comment" type="text" sortOrder="12" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Cron Failed Jobs Warning Threshold (24h)</label>
                    <comment>Number of failed cron jobs in 24 hours before status becomes degraded (default: 5)</comment>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="cron_enabled">1</field>
                    </depends>
                </field>
                <field id="indexer_enabled" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Indexer Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Check indexer health and invalid indexes</comment>
                </field>
                <field id="cache_enabled" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Cache Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Check cache types and invalidation status</comment>
                </field>
                <field id="database_enabled" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Database Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Check database connectivity</comment>
                </field>
                <field id="system_enabled" translate="label comment" type="select" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>System Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Check PHP version, disk space, and memory</comment>
                </field>
                <field id="search_enabled" translate="label comment" type="select" sortOrder="60" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Search Engine Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Check Elasticsearch/OpenSearch cluster health and catalog index status</comment>
                </field>
                <field id="queue_enabled" translate="label comment" type="select" sortOrder="70" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Message Queue Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Check message queue depth, failed messages, and consumer health</comment>
                </field>
                <field id="deploy_enabled" translate="label comment" type="select" sortOrder="80" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Deploy Mode Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Check deploy mode, maintenance status, and compilation state</comment>
                </field>
                <field id="redis_enabled" translate="label comment" type="select" sortOrder="90" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Redis Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Check Redis connectivity and memory for session, cache, and page cache</comment>
                </field>
                <field id="log_enabled" translate="label comment" type="select" sortOrder="100" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Log Health Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Check log file sizes, debug logging, and error report accumulation</comment>
                </field>
                <field id="admin_security_enabled" translate="label comment" type="select" sortOrder="110" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Admin Security Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Check failed login attempts, locked accounts, and 2FA status</comment>
                </field>
                <field id="config_hygiene_enabled" translate="label comment" type="select" sortOrder="120" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Config Hygiene Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Check for production misconfigurations (template hints, minification, etc.)</comment>
                </field>
                <field id="ssl_enabled" translate="label comment" type="select" sortOrder="130" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>SSL Certificate Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Check SSL certificate validity and expiry for the store base URL</comment>
                </field>
                <field id="orders_enabled" translate="label comment" type="select" sortOrder="140" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Order Pipeline Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Check for stuck orders and payment failures</comment>
                </field>
                <field id="integrations_enabled" translate="label comment" type="select" sortOrder="150" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Integration Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Check API integrations and OAuth token health</comment>
                </field>
                <field id="phpfpm_enabled" translate="label comment" type="select" sortOrder="160" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>PHP-FPM Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[Check PHP-FPM process pool saturation. Requires <code>pm.status_path = /status</code> in your php-fpm pool config.]]></comment>
                </field>
                <field id="phpfpm_status_url" translate="label comment" type="text" sortOrder="161" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>PHP-FPM Status URL</label>
                    <comment>URL to the PHP-FPM status page (default: http://localhost/status?json)</comment>
                    <depends>
                        <field id="phpfpm_enabled">1</field>
                    </depends>
                </field>
                <field id="media_integrity_enabled" translate="label comment" type="select" sortOrder="170" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Media Integrity Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Scan pub/media/ for PHP webshells and suspicious file accumulation in upload directories</comment>
                </field>
                <field id="upload_endpoint_enabled" translate="label comment" type="select" sortOrder="180" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Upload Endpoint Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Monitor access logs for automated POST requests to file-upload endpoints</comment>
                </field>
                <field id="upload_endpoint_log_path" translate="label comment" type="text" sortOrder="181" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Access Log Path</label>
                    <comment>Absolute path to the web server access log. Leave empty to auto-detect common locations (/var/log/nginx/access.log, etc.)</comment>
                    <depends>
                        <field id="upload_endpoint_enabled">1</field>
                    </depends>
                </field>
                <field id="database_size_enabled" translate="label comment" type="select" sortOrder="190" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Database Size Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Monitor total database size and largest tables. Results are cached for 24 hours.</comment>
                </field>
                <field id="log_errors_enabled" translate="label comment" type="select" sortOrder="200" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Log Error Monitoring</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Parse exception.log and system.log for CRITICAL/ERROR entries and report unique error signatures. Uses incremental reading (only new content since last check).</comment>
                </field>
                <field id="content_integrity_enabled" translate="label comment" type="select" sortOrder="210" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Content Integrity Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Scan core_config_data head/footer HTML and CMS block/page content (all scopes) for injected skimmer / obfuscated JavaScript. Flags a compromise distinct from downtime.</comment>
                </field>
                <field id="content_integrity_script_allowlist" translate="label comment" type="textarea" sortOrder="211" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Trusted Script Hosts</label>
                    <comment>Extra hostnames allowed in &lt;script src&gt; within stored content (comma or newline separated), beyond the built-in list and your store's own domain. An unrecognized external script is reported for review, not flagged as compromised.</comment>
                    <depends>
                        <field id="content_integrity_enabled">1</field>
                    </depends>
                </field>
                <field id="transactional_email_enabled" translate="label comment" type="select" sortOrder="220" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Transactional Email Monitoring</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Detect sales confirmation emails (order/invoice/shipment/creditmemo) that were never sent: permanently lost sends (email_sent NULL after a failed synchronous send — Magento never retries these) and stuck async retry backlogs (email_sent 0 older than the send cron should allow).</comment>
                </field>
            </group>
        </section>
    </system>
</config>
